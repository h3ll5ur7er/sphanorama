{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native debug \u2014 the default for TDD",
      "binaryDir": "${sourceDir}/build/native-debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native release \u2014 what the bench measures",
      "binaryDir": "${sourceDir}/build/native-release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "native-asan",
      "displayName": "Native with address and UB sanitizers",
      "description": "vptr is excluded because it needs RTTI and the core is built -fno-rtti (ADR 0012): left on it reports every GoogleTest dispatch as invalid and buries a real finding. Recovery is off so undefined behaviour fails the run instead of printing and passing.",
      "binaryDir": "${sourceDir}/build/native-asan",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=vptr -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WASM, single-threaded \u2014 the build GitHub Pages can serve",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPHANORAMA_BUILD_TESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-msimd128 -Oz -flto"
      }
    },
    {
      "name": "wasm-release-threaded",
      "inherits": "wasm-release",
      "displayName": "WASM, threaded \u2014 needs a host that can serve COOP/COEP",
      "binaryDir": "${sourceDir}/build/wasm-release-threaded",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-msimd128 -pthread -Oz -flto",
        "CMAKE_EXE_LINKER_FLAGS": "-pthread -sPTHREAD_POOL_SIZE=navigator.hardwareConcurrency"
      }
    },
    {
      "name": "wasm-debug",
      "inherits": "wasm-release",
      "displayName": "WASM with assertions, for chasing a browser-only failure",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-msimd128 -O0 -g",
        "CMAKE_EXE_LINKER_FLAGS": "-sASSERTIONS=2 -sSAFE_HEAP=1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    },
    {
      "name": "wasm-release-threaded",
      "configurePreset": "wasm-release-threaded"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
